{
  "info": {
    "name": "FuelPilot",
    "description": "FuelPilot API: 9 requests with tests. Set `base_url` if the server is not on http://localhost:8000. Request 1 saves `plan_id` (only on a 200) for request 6, which skips itself without one. One run sends 7 POSTs; the API allows 30 POSTs a minute, so a 5th run within one minute gets 429.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "FuelPilot",
      "item": [
        {
          "name": "1. Long trip, city names",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Read the body once; a non-JSON reply (e.g. an HTML proxy page) shows no error detail.",
                  "let body = {};",
                  "try { body = pm.response.json(); } catch (error) { console.log(\"Body is not JSON:\", error.message); }",
                  "pm.test(\"status is 200\", () => pm.expect(pm.response.code, JSON.stringify(body.error)).to.eql(200));",
                  "pm.test(\"routing_calls is 0 or 1\", () => pm.expect([0, 1]).to.include(body.meta.routing_calls));",
                  "pm.test(\"at least 2 fuel stops\", () => pm.expect(body.fuel_stops.length).to.be.at.least(2));",
                  "pm.test(\"total is money text\", () => pm.expect(body.totals.total_purchase_cost).to.match(/^\\d+\\.\\d{2}$/));",
                  "pm.test(\"map_url points to this plan's map\", () => pm.expect(body.map_url.endsWith(\"/fuel-plans/\" + body.plan_id + \"/map\")).to.be.true);",
                  "// Only a 200 has a plan to show; request 6 skips itself when plan_id is empty.",
                  "pm.collectionVariables.set(\"plan_id\", pm.response.code === 200 ? body.plan_id : \"\");"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start\": {\n    \"city\": \"Chicago\",\n    \"state\": \"IL\"\n  },\n  \"finish\": {\n    \"city\": \"Denver\",\n    \"state\": \"CO\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/fuel-plans",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "fuel-plans"
              ]
            },
            "description": "Chicago, IL → Denver, CO with default fuel values. Expects at least 2 stops and saves `plan_id` for the map request. `routing_calls` is 1 on a cold run, 0 on a re-run."
          },
          "response": []
        },
        {
          "name": "2. Same request again",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Read the body once; a non-JSON reply (e.g. an HTML proxy page) shows no error detail.",
                  "let body = {};",
                  "try { body = pm.response.json(); } catch (error) { console.log(\"Body is not JSON:\", error.message); }",
                  "pm.test(\"status is 200\", () => pm.expect(pm.response.code, JSON.stringify(body.error)).to.eql(200));",
                  "pm.test(\"routing_calls is 0\", () => pm.expect(body.meta.routing_calls).to.eql(0));",
                  "pm.test(\"same plan_id as request 1\", () => pm.expect(body.plan_id).to.eql(pm.collectionVariables.get(\"plan_id\")));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start\": {\n    \"city\": \"Chicago\",\n    \"state\": \"IL\"\n  },\n  \"finish\": {\n    \"city\": \"Denver\",\n    \"state\": \"CO\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/fuel-plans",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "fuel-plans"
              ]
            },
            "description": "The same body as request 1: served from the plan cache with 0 routing calls and the same `plan_id`."
          },
          "response": []
        },
        {
          "name": "3. Short trip, coordinates",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Read the body once; a non-JSON reply (e.g. an HTML proxy page) shows no error detail.",
                  "let body = {};",
                  "try { body = pm.response.json(); } catch (error) { console.log(\"Body is not JSON:\", error.message); }",
                  "pm.test(\"status is 200\", () => pm.expect(pm.response.code, JSON.stringify(body.error)).to.eql(200));",
                  "pm.test(\"no fuel stops\", () => pm.expect(body.fuel_stops).to.eql([]));",
                  "pm.test(\"total is 0.00\", () => pm.expect(body.totals.total_purchase_cost).to.eql(\"0.00\"));",
                  "pm.test(\"start.matched is null\", () => pm.expect(body.start.matched).to.be.null);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start\": {\n    \"latitude\": 32.7767,\n    \"longitude\": -96.797\n  },\n  \"finish\": {\n    \"latitude\": 29.7604,\n    \"longitude\": -95.3698\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/fuel-plans",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "fuel-plans"
              ]
            },
            "description": "Dallas → Houston by coordinates (under 400 mi): the start tank covers it, so no stop and a total of 0.00. `matched` is null for coordinate input."
          },
          "response": []
        },
        {
          "name": "4. Outside the USA",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Read the body once; a non-JSON reply (e.g. an HTML proxy page) shows no error detail.",
                  "let body = {};",
                  "try { body = pm.response.json(); } catch (error) { console.log(\"Body is not JSON:\", error.message); }",
                  "pm.test(\"status is 422\", () => pm.expect(pm.response.code, JSON.stringify(body.error)).to.eql(422));",
                  "pm.test(\"error code is unsupported_location\", () => pm.expect(body.error.code).to.eql(\"unsupported_location\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start\": {\n    \"latitude\": 43.65,\n    \"longitude\": -79.38\n  },\n  \"finish\": {\n    \"city\": \"Buffalo\",\n    \"state\": \"NY\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/fuel-plans",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "fuel-plans"
              ]
            },
            "description": "Start in Toronto (43.65, -79.38): rejected before any routing call."
          },
          "response": []
        },
        {
          "name": "5. No feasible plan",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Read the body once; a non-JSON reply (e.g. an HTML proxy page) shows no error detail.",
                  "let body = {};",
                  "try { body = pm.response.json(); } catch (error) { console.log(\"Body is not JSON:\", error.message); }",
                  "pm.test(\"status is 422\", () => pm.expect(pm.response.code, JSON.stringify(body.error)).to.eql(422));",
                  "pm.test(\"error code is no_feasible_plan\", () => pm.expect(body.error.code).to.eql(\"no_feasible_plan\"));",
                  "pm.test(\"details present\", () => pm.expect(body.error.details).to.be.an(\"object\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start\": {\n    \"city\": \"Chicago\",\n    \"state\": \"IL\"\n  },\n  \"finish\": {\n    \"city\": \"Denver\",\n    \"state\": \"CO\"\n  },\n  \"reserve_gallons\": 45\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/fuel-plans",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "fuel-plans"
              ]
            },
            "description": "Chicago, IL → Denver, CO with a 45-gal reserve: legs are limited to 50 mi from the start and 40 mi after a purchase, so some stretch has no reachable station."
          },
          "response": []
        },
        {
          "name": "6. Map page",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Without a plan_id from request 1 there is no map to open: skip, do not fail.",
                  "// Older runners have no pm.execution.skipRequest; they send the request and its tests fail.",
                  "if (!pm.collectionVariables.get(\"plan_id\")) {",
                  "  console.log(\"Request 6 skipped: request 1 did not return a plan_id.\");",
                  "  if (pm.execution && pm.execution.skipRequest) {",
                  "    pm.execution.skipRequest();",
                  "  }",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"content is HTML\", () => pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/html\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/fuel-plans/{{plan_id}}/map",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "fuel-plans",
                "{{plan_id}}",
                "map"
              ]
            },
            "description": "The map page of the plan saved by request 1 (run request 1 first). Open the same URL in a browser to see the map."
          },
          "response": []
        },
        {
          "name": "7. Invalid body",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Read the body once; a non-JSON reply (e.g. an HTML proxy page) shows no error detail.",
                  "let body = {};",
                  "try { body = pm.response.json(); } catch (error) { console.log(\"Body is not JSON:\", error.message); }",
                  "pm.test(\"status is 400\", () => pm.expect(pm.response.code, JSON.stringify(body.error)).to.eql(400));",
                  "pm.test(\"error code is invalid_request\", () => pm.expect(body.error.code).to.eql(\"invalid_request\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start\": {\n    \"city\": \"Chicago\",\n    \"state\": \"IL\",\n    \"latitude\": 41.85\n  },\n  \"finish\": {\n    \"city\": \"Denver\",\n    \"state\": \"CO\"\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/fuel-plans",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "fuel-plans"
              ]
            },
            "description": "`start` has both a city and a latitude: a 400, with 0 routing calls."
          },
          "response": []
        },
        {
          "name": "8. Unknown plan",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Read the body once; a non-JSON reply (e.g. an HTML proxy page) shows no error detail.",
                  "let body = {};",
                  "try { body = pm.response.json(); } catch (error) { console.log(\"Body is not JSON:\", error.message); }",
                  "pm.test(\"status is 404\", () => pm.expect(pm.response.code, JSON.stringify(body.error)).to.eql(404));",
                  "pm.test(\"error code is plan_not_found\", () => pm.expect(body.error.code).to.eql(\"plan_not_found\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/fuel-plans/00000000-0000-4000-8000-000000000000/map",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "fuel-plans",
                "00000000-0000-4000-8000-000000000000",
                "map"
              ]
            },
            "description": "A well-formed plan id that was never saved: 404 plan_not_found."
          },
          "response": []
        },
        {
          "name": "9. Low fuel at the start",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Read the body once; a non-JSON reply (e.g. an HTML proxy page) shows no error detail.",
                  "let body = {};",
                  "try { body = pm.response.json(); } catch (error) { console.log(\"Body is not JSON:\", error.message); }",
                  "pm.test(\"status is 200\", () => pm.expect(pm.response.code, JSON.stringify(body.error)).to.eql(200));",
                  "pm.test(\"at least 1 fuel stop\", () => pm.expect(body.fuel_stops.length).to.be.at.least(1));",
                  "pm.test(\"start fuel is not charged\", () => pm.expect(body.assumptions.start_fuel_charged).to.be.false);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"start\": {\n    \"city\": \"Columbus\",\n    \"state\": \"OH\"\n  },\n  \"finish\": {\n    \"city\": \"Nashville\",\n    \"state\": \"TN\"\n  },\n  \"current_fuel_gallons\": 15\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/api/v1/fuel-plans",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "v1",
                "fuel-plans"
              ]
            },
            "description": "Columbus, OH → Nashville, TN starting with 15 gal: the start tank cannot cover the trip, so at least one stop; the start fuel is never charged."
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8000",
      "type": "string"
    },
    {
      "key": "plan_id",
      "value": "",
      "type": "string"
    }
  ]
}
