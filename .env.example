# Copy to .env and fill in. .env is gitignored; never commit real values.
# Generate a key: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
FUELPILOT_DEBUG=false
FUELPILOT_ALLOWED_HOSTS=localhost,127.0.0.1
FUELPILOT_ROUTING_BASE_URL=https://router.project-osrm.org
# Seconds, clamped to 1-30. READ is the total deadline for the whole response body.
FUELPILOT_ROUTING_CONNECT_TIMEOUT_S=3
FUELPILOT_ROUTING_READ_TIMEOUT_S=10
FUELPILOT_PLAN_TTL_S=604800
# Owner only: needed by `manage.py geocode_stations`, never by the API.
GEOAPIFY_API_KEY=
# Owner only, used by `manage.py geocode_stations`. Timeouts in seconds, clamped to 1-60.
GEOAPIFY_BASE_URL=https://api.geoapify.com
GEOAPIFY_CONNECT_TIMEOUT_S=10
GEOAPIFY_TOTAL_TIMEOUT_S=30
